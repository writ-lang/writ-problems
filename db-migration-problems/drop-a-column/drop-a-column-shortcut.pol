; The same drop, with ONE WORD REMOVED — `settled`, from the guard on
; `drop-column`. That is the whole file.
;
; It reads as a perfectly sensible plan: deploy the release that stops using
; the column, then drop the column. The missing word is the difference between
; "the deploy has finished" and "the deploy has started", and on a screen those
; look like the same sentence.
;
; The questions next door are unchanged, so any difference in the answers comes
; from that one word.
;
; `pol check` exits 1 on this file.

(load "stdlib.pol")
(load "drop-a-column.lib.pol")

(schema drop-a-column

  ; A column either exists or it does not. Nothing else about it matters here.
  (type presence (absent present))
  (type column (arrow state (to presence)))

  ; Two releases: the one that uses the column, and the one that does not.
  (type release (r1 r2))

  ; What each release does with each column — a relation, and `fixed`, because
  ; a release's behaviour is wiring rather than state.
  (type reads
    (arrow by  (to release) fixed)
    (arrow col (to column)  fixed))
  (type writes
    (arrow by  (to release) fixed)
    (arrow col (to column)  fixed))

  ; The fleet. While `old` and `new` differ, a rollout is in progress and BOTH
  ; are serving traffic. That window is the whole problem.
  (type fleet
    (arrow old (to release))
    (arrow new (to release)))

  ; Two rules, and they are the obvious two. Each ranges over `fleet`, reaching
  ; the read/write sets through `some`, because a rule ranges over one kind of
  ; thing and its paths are written from that kind rather than from a named
  ; item.

  (equation read-of-existing
    (not (some (R reads)
           (and (or (is R.by fleet.old) (is R.by fleet.new))
                (is R.col.state absent)))))

  (equation write-of-existing
    (not (some (W writes)
           (and (or (is W.by fleet.old) (is W.by fleet.new))
                (is W.col.state absent))))))

(instance start drop-a-column

  (column flag-col (state present))

  ; r1 uses the column. r2 is the release that stopped.
  (reads  rd1 (by r1) (col flag-col))
  (writes wr1 (by r1) (col flag-col))

  ; r2 appears in neither list, which is the point of it.

  (fleet prod (old r1) (new r1)))

(use drop-a-column)
(initial start)

; ---- the runbook ----

; Start rolling out the release that no longer touches the column.
(transition deploy-r2
  (when (and settled (is prod.new r1)))
  (do (set prod.new r2)))

; The rollout finishes and the old release drains away.
(transition settle
  (when rolling)
  (do (set prod.old prod.new)))

; Drop the column as soon as the new release has STARTED going out.
(transition drop-column
  (when (and (is prod.new r2) (is flag-col.state present)))   ; <- `settled`, gone
  (do (set flag-col.state absent)))
