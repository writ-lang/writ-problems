; The same migration, with ONE CONJUNCT REMOVED — and that is the whole file.
;
; This is migration.pol with `(is full-col.filled yes)` struck from
; `deploy-r3`'s guard: the release that starts READING the new column is
; allowed out before the backfill has finished. It is the tempting shortcut,
; because at that moment the column exists, every live release writes it, and
; a staging database — whose rows were all written after the column arrived —
; looks perfectly fine.
;
; The questions are the ones next door, unchanged. Holding them fixed is the
; point of the pair: the difference in the verdicts is attributable to this one
; conjunct and to nothing else.
;
; `pol check` exits 1 on this file. That is the gate refusing the merge.

(load "stdlib.pol")
(load "migration.lib.pol")

(schema migration

  ; ---- the database ----
  (type presence (absent present))
  (type done     (no yes))

  ; A column, and whether every row has a value for it. `filled` is the
  ; backfill: a column can exist and still be empty for the rows written
  ; before it did, which is the trap the naive plan falls into.
  (type column
    (arrow state  (to presence))
    (arrow filled (to done)))

  ; ---- the code ----
  (type release (r1 r2 r3 r4))

  ; What each release does with each column. This is a relation, not an arrow,
  ; so it is a junction type — and `fixed`, because a release's behaviour is
  ; wiring: r2 writes what r2 writes, in every situation. Written out rather
  ; than through the standard library's `span`, which names its arrows `left`
  ; and `right`; here they are read in laws, where `R.by` and `R.col` say what
  ; they mean and `R.left` would not.
  (type reads
    (arrow by  (to release) fixed)
    (arrow col (to column)  fixed))
  (type writes
    (arrow by  (to release) fixed)
    (arrow col (to column)  fixed))

  ; ---- the fleet ----
  ; A rolling deploy is not atomic. `old` and `new` are the releases running;
  ; while they differ the rollout is in flight and BOTH are serving traffic.
  ; Every law below has to hold of both, which is the whole difficulty.
  (type fleet
    (arrow old (to release))
    (arrow new (to release)))

  ; ---- the compatibility rules ----
  ; Each ranges over `fleet` — a law has exactly one free root, and chains are
  ; written from the TYPE — so the reads and writes are reached by `some`.

  ; 1. Nobody reads a column that is not there.
  (equation read-of-existing
    (not (some (R reads)
           (and (or (is R.by fleet.old) (is R.by fleet.new))
                (is R.col.state absent)))))

  ; 2. Nobody writes a column that is not there.
  (equation write-of-existing
    (not (some (W writes)
           (and (or (is W.by fleet.old) (is W.by fleet.new))
                (is W.col.state absent)))))

  ; 3. Nobody reads a column whose backfill has not finished. A column can be
  ; present and empty; a reader that arrives before the backfill reads nothing
  ; for every row written before the column existed.
  (equation read-of-filled
    (not (some (R reads)
           (and (or (is R.by fleet.old) (is R.by fleet.new))
                (is R.col.filled no)))))

  ; 4. THE ONE HUMANS GET WRONG, and the reason this is worth exhausting: a
  ; column read by one live release must be written by EVERY live release. Mid
  ; rollout the old release is still serving writes, and if it does not write
  ; the column the new one reads, the new one reads nothing for the rows the
  ; old one just wrote. The window is only as long as a deploy, which is
  ; exactly why it survives review and fails in production.
  (equation read-implies-every-writer
    (not (some (R reads)
           (and (or (is R.by fleet.old) (is R.by fleet.new))
                (not (and (some (W writes)
                            (and (is W.by fleet.old) (is W.col R.col)))
                          (some (W writes)
                            (and (is W.by fleet.new) (is W.col R.col))))))))))

(instance start migration

  ; The rename: `name` is going away, `full-name` is arriving. The old column
  ; is there and full; the new one does not exist yet.
  (column name-col (state present) (filled yes))
  (column full-col (state absent)  (filled no))

  ; The four releases of the code, as read/write sets.
  ;   r1  the world before        reads name        writes name
  ;   r2  expand                  reads name        writes name, full
  ;   r3  switch the readers      reads full        writes name, full
  ;   r4  contract                reads full        writes full
  ; r2 and r3 both write BOTH columns; that overlap is what makes a rolling
  ; deploy between them safe, and it is the whole content of the pattern.
  (reads  rd1 (by r1) (col name-col))
  (reads  rd2 (by r2) (col name-col))
  (reads  rd3 (by r3) (col full-col))
  (reads  rd4 (by r4) (col full-col))

  (writes wr1 (by r1) (col name-col))
  (writes wr2 (by r2) (col name-col))
  (writes wr3 (by r2) (col full-col))
  (writes wr4 (by r3) (col name-col))
  (writes wr5 (by r3) (col full-col))
  (writes wr6 (by r4) (col full-col))

  ; production, before any of this: one release, settled.
  (fleet prod (old r1) (new r1)))

(use migration)
(initial start)

; ---- the runbook ----
; The guards ARE the plan. Each says the precondition the operator is claiming
; to have checked; the laws above say whether claiming it is enough.

; Adding a nullable column is safe at any time — nothing reads or writes it yet.
(transition add-column
  (when (is full-col.state absent))
  (do (set full-col.state present)))

; Backfill needs the column to exist, and is only complete once every live
; release writes it — otherwise a release that does not is filling the table
; with rows the backfill has already passed.
(transition backfill
  (when (and (is full-col.state present)
             (is full-col.filled no)
             settled
             (writes-col W prod.new full-col)))
  (do (set full-col.filled yes)))

; A rollout starts from a settled fleet and moves one release forward. While it
; is in flight, `old` and `new` differ and both are serving.
(transition deploy-r2
  (when (and settled (is prod.new r1) (is full-col.state present)))
  (do (set prod.new r2)))

; r3 is the first release to READ the new column. In migration.pol it waits for
; the backfill; here it does not.
(transition deploy-r3
  (when (and settled (is prod.new r2)))          ; <- the backfill check, gone
  (do (set prod.new r3)))

; r4 stops writing the old column, so it may not go out while anything still
; reads it — which is to say, not until r3 is everywhere.
(transition deploy-r4
  (when (and settled (is prod.new r3)))
  (do (set prod.new r4)))

; The rollout finishes: the old release drains away.
(transition settle
  (when rolling)
  (do (set prod.old prod.new)))

; The contract, last: the old column goes only once no live release touches it.
(transition drop-column
  (when (and settled (is prod.new r4) (is name-col.state present)))
  (do (set name-col.state absent)))
