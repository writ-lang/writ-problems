; Shared by the models and the questions. The questions file has its own form
; scope, so anything used in both has to live somewhere both can load.
(load "stdlib.pol")

; Does RELEASE read (or write) COLUMN? The read/write sets are relations, so
; each is a small record per pair and the question is an existential over them.
; W and R are SLOTS: a form template may not head a list with a `some` binder
; unless it was passed in, which is how the standard library's `all` does it.
(form (writes-col W REL COL) (some (W writes) (and (is W.by REL) (is W.col COL))))
(form (reads-col  R REL COL) (some (R reads)  (and (is R.by REL) (is R.col COL))))

; One release live, or two: `settled` is the whole safety condition here.
(form settled (is prod.old prod.new))
(form rolling (differ prod.old prod.new))

; Where we are trying to get to.
(form dropped (and (is flag-col.state absent) settled (is prod.new r2)))
