; Shared by the models and the questions, because a questions file has its own
; form scope and there is no implicit prelude.
(load "stdlib.writ")

(form settled (is prod.old prod.new))
(form rolling (differ prod.old prod.new))

; Where we are going: the constraint validated, no orphans, the fleet settled
; on r2. (Old and new spelled out rather than `settled`, which compares two
; paths and so cannot appear in a .rules guard.)
(form done (and (is customer-fk.state validated)
                (is orders-table.orphans none)
                (is prod.old r2) (is prod.new r2)))
