; 50TB of files -> classify (configurably, re-runnably) -> feed AI -> surface in CRM.
; The COMPONENT BANK, and the moves that realise one architecture out of it.

(load "../libraries/arch.lib.writ")

(instance bank arch

  ; ---- the stages, in build order ------------------------------------------
  (cap hold (next enumerate)
            (chosen vacant)
            (needs-bulk yes)
            (needs-scan no)
            (needs-rerun no)
            (needs-loose no))
  (cap enumerate (next extract)
                 (chosen vacant)
                 (needs-bulk yes)
                 (needs-scan no)
                 (needs-rerun no)
                 (needs-loose no))
  (cap extract (next classify)
               (chosen vacant)
               (needs-bulk no)
               (needs-scan yes)
               (needs-rerun no)
               (needs-loose no))
  (cap classify (next catalog)
                (chosen vacant)
                (needs-bulk no)
                (needs-scan no)
                (needs-rerun yes)
                (needs-loose no))
  (cap catalog (next serve-ai)
               (chosen vacant)
               (needs-bulk no)
               (needs-scan no)
               (needs-rerun no)
               (needs-loose no))
  (cap serve-ai (next surface)
                (chosen vacant)
                (needs-bulk no)
                (needs-scan no)
                (needs-rerun no)
                (needs-loose no))
  (cap surface (next done)
               (chosen vacant)
               (needs-bulk no)
               (needs-scan no)
               (needs-rerun no)
               (needs-loose yes))
  (cap done (next vacant)
            (chosen vacant)
            (needs-bulk no)
            (needs-scan no)
            (needs-rerun no)
            (needs-loose no))

  ; what each stage demands — this is the BRIEF, formalised

  ; ---- the component bank --------------------------------------------------
  (comp object-store (bulk yes)
                     (scans vacant)
                     (rerunnable vacant)
                     (persists yes)
                     (couples vacant))
  (comp nas (bulk no)
            (scans vacant)
            (rerunnable vacant)
            (persists yes)
            (couples vacant))
  (comp bucket-list (bulk no)
                    (scans vacant)
                    (rerunnable vacant)
                    (persists no)
                    (couples vacant))
  (comp event-stream (bulk yes)
                     (scans vacant)
                     (rerunnable vacant)
                     (persists no)
                     (couples vacant))
  (comp db-index (bulk yes)
                 (scans vacant)
                 (rerunnable vacant)
                 (persists yes)
                 (couples vacant))
  (comp pdf-lib (bulk vacant)
                (scans no)
                (rerunnable vacant)
                (persists no)
                (couples vacant))
  (comp ocr-service (bulk vacant)
                    (scans yes)
                    (rerunnable vacant)
                    (persists yes)
                    (couples vacant))
  (comp llm-vision (bulk vacant)
                   (scans yes)
                   (rerunnable vacant)
                   (persists no)
                   (couples vacant))
  (comp rules-engine (bulk vacant)
                     (scans vacant)
                     (rerunnable yes)
                     (persists yes)
                     (couples vacant))
  (comp llm-classifier (bulk vacant)
                       (scans vacant)
                       (rerunnable no)
                       (persists yes)
                       (couples vacant))
  (comp ml-model (bulk vacant)
                 (scans vacant)
                 (rerunnable yes)
                 (persists yes)
                 (couples vacant))
  (comp lakehouse (bulk vacant)
                  (scans vacant)
                  (rerunnable vacant)
                  (persists yes)
                  (couples vacant))
  (comp rdbms (bulk vacant)
              (scans vacant)
              (rerunnable vacant)
              (persists yes)
              (couples vacant))
  (comp doc-store (bulk vacant)
                  (scans vacant)
                  (rerunnable vacant)
                  (persists yes)
                  (couples vacant))
  (comp vector-index (bulk vacant)
                     (scans vacant)
                     (rerunnable vacant)
                     (persists yes)
                     (couples vacant))
  (comp dataset-export (bulk vacant)
                       (scans vacant)
                       (rerunnable vacant)
                       (persists yes)
                       (couples vacant))
  (comp crm-api (bulk vacant)
                (scans vacant)
                (rerunnable vacant)
                (persists no)
                (couples contract))
  (comp ipaas (bulk vacant)
              (scans vacant)
              (rerunnable vacant)
              (persists no)
              (couples loose))
  (comp direct-db (bulk vacant)
                  (scans vacant)
                  (rerunnable vacant)
                  (persists no)
                  (couples tight))

  ; llm-classifier is NOT deterministic across runs unless model+params are
  ; pinned — and the brief asks for re-runnable classification.

  ; does the stage keep its output, or stream it away?

  ; ---- provides: one junction entity per (component, stage) edge -----------
  (prov v1 (p-comp object-store)
           (p-cap hold))
  (prov v2 (p-comp nas)
           (p-cap hold))
  (prov v3 (p-comp bucket-list)
           (p-cap enumerate))
  (prov v4 (p-comp event-stream)
           (p-cap enumerate))
  (prov v5 (p-comp db-index)
           (p-cap enumerate))
  (prov v6 (p-comp pdf-lib)
           (p-cap extract))
  (prov v7 (p-comp ocr-service)
           (p-cap extract))
  (prov v8 (p-comp llm-vision)
           (p-cap extract))
  (prov v9 (p-comp rules-engine)
           (p-cap classify))
  (prov v10 (p-comp llm-classifier)
            (p-cap classify))
  (prov v11 (p-comp ml-model)
            (p-cap classify))
  (prov v12 (p-comp lakehouse)
            (p-cap catalog))
  (prov v13 (p-comp rdbms)
            (p-cap catalog))
  (prov v14 (p-comp doc-store)
            (p-cap catalog))
  (prov v15 (p-comp vector-index)
            (p-cap serve-ai))
  (prov v16 (p-comp dataset-export)
            (p-cap serve-ai))
  (prov v17 (p-comp crm-api)
            (p-cap surface))
  (prov v18 (p-comp ipaas)
            (p-cap surface))
  (prov v19 (p-comp direct-db)
            (p-cap surface))

  ; ---- requires: the same span, the other direction ------------------------
  (req q1 (r-comp db-index)
          (r-cap hold))
  (req q2 (r-comp vector-index)
          (r-cap extract))
  (req q3 (r-comp dataset-export)
          (r-cap catalog))
  (req q4 (r-comp crm-api)
          (r-cap catalog))
  (req q5 (r-comp ipaas)
          (r-cap catalog))
  (req q6 (r-comp direct-db)
          (r-cap catalog))

  (cursor cur (at hold)))

(use arch)
(initial bank)

; ---- the moves: one per component ------------------------------------------
(pick hold-object-store object-store hold rr)
(pick hold-nas nas hold rr)
(pick enum-bucket-list bucket-list enumerate rr)
(pick enum-event-stream event-stream enumerate rr)
(pick enum-db-index db-index enumerate rr)
(pick ext-pdf-lib pdf-lib extract rr)
(pick ext-ocr ocr-service extract rr)
(pick ext-llm-vision llm-vision extract rr)
(pick cls-rules rules-engine classify rr)
(pick cls-llm llm-classifier classify rr)
(pick cls-ml ml-model classify rr)
(pick cat-lakehouse lakehouse catalog rr)
(pick cat-rdbms rdbms catalog rr)
(pick cat-doc-store doc-store catalog rr)
(pick ai-vector-index vector-index serve-ai rr)
(pick ai-dataset-export dataset-export serve-ai rr)
(pick crm-api-push crm-api surface rr)
(pick crm-ipaas ipaas surface rr)
(pick crm-direct-db direct-db surface rr)

; ---- what the brief does not say -------------------------------------------
(transition pdf-kind-unknown
  (when (is cur.at extract))
  (do (gap "the brief is silent: are the 50TB of PDFs digital-native or scanned? extract choice depends on it")))
