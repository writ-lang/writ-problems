; Shared by the models and the questions, because a questions file has its own
; form scope and there is no implicit prelude.
(load "stdlib.writ")

; Does RELEASE write COLUMN? The write set is a relation, so it is a small
; record per pair and the question is an existential. W is a SLOT: a form
; template may not head a list with a `some` binder unless it was passed in.
(form (writes-col W REL COL) (some (W writes) (and (is W.by REL) (is W.col COL))))

(form settled (is prod.old prod.new))
(form rolling (differ prod.old prod.new))

; Every live release writes the column — the condition the constraint depends
; on, and the one the shortcut forgets.
(form (every-live-writes W COL)
  (and (writes-col W prod.old COL) (writes-col W prod.new COL)))

; Where we are going: the column exists, holds a value in every row, and is
; declared NOT NULL.
(form enforced (and (is country-col.state present)
                    (is country-col.filled yes)
                    (is country-col.required yes)))
