; One mill, and the claim that abolishing its private ownership abolishes
; exploitation. Twenty-six lines of model; the claim is in gotha.claims.
;
; THE POINT OF THE SCHEMA is that where ordinary speech has one word — "owns" —
; the mill has three arrows, and they are free to move independently:
;
;   worked-by     who does the work                       (fixed: a fact)
;   directed-by   whose decision disposes of the product  (the control right)
;   surplus-to    where this period's surplus went        (the distribution)
;
; Under a proprietor all three are settled together, which is what makes
; "abolish private ownership" sound like a complete instruction. It names only
; `title`, a fourth arrow, and the model has to be able to say so BEFORE any
; move is written — otherwise the finding below would be built into the moves
; rather than found among them.
;
; Every move here is one the programme itself calls for. Nothing is smuggled in:
; see the header of gotha.claims for which text asks for which move.

(load "stdlib.writ")   ; `=` is a stdlib form (§8.6); there is no implicit prelude

(schema commons
  (type yn      (no yes))
  (type title-t (private common))
  (type claimant
    (arrow produces (to yn) fixed))     ; whether a party does the work: a fact,
  (type mill                            ; not a setting — no move rewrites it
    (arrow title       (to title-t))
    (arrow worked-by   (to claimant) fixed)
    (arrow directed-by (to claimant))
    (maybe surplus-to claimant))
  ; THE PROGRAMME AS A LAW. Two routes mill → claimant — where the surplus went,
  ; and who did the work — which must agree. Not a rule the model obeys: the
  ; promise the model is measured against, so `writ` reports which situations
  ; break it.
  (equation surplus-to-producers
    (= mill.surplus-to mill.worked-by)))

(instance old-regime commons
  (claimant weavers    (produces yes))
  (claimant proprietor (produces no))
  (claimant board      (produces no))
  (mill loom-house (title       private)
                   (worked-by   weavers)
                   (directed-by proprietor)
                   (surplus-to  proprietor)))

(use commons)
(initial old-regime)

; THE EXPROPRIATION, granted in full and granted at once: title passes to the
; commons, direction passes to those who work the mill, and the proprietor's
; claim on the surplus lapses. There is no move back — no restoration, no
; sabotage, no invasion — so nothing found below can be blamed on the revolution
; having been incomplete or reversed.
(transition expropriate
  (when (is loom-house.title private))
  (do (set loom-house.title common)
      (set loom-house.directed-by weavers)
      (vacate loom-house.surplus-to)))

; DISTRIBUTION TO THE PRODUCERS — the programme's own purpose, available from
; the moment the mill is common and directed by those who work it.
(transition distribute
  (when (and (is loom-house.title common)
             (is loom-house.directed-by weavers)))
  (do (set loom-house.surplus-to weavers)))

; THE ADMINISTRATION. Gotha's deductions do not administer themselves, and the
; commune appoints a body to do it — which is a transfer of the DIRECTION, not
; only of the bookkeeping, because a body that may not decide cannot make a
; deduction. This is the move the claim does not mention and does not forbid.
(transition appoint-board
  (when (and (is loom-house.title common)
             (is loom-house.directed-by weavers)))
  (do (set loom-house.directed-by board)))

; "THE GENERAL COSTS OF ADMINISTRATION NOT BELONGING TO PRODUCTION" — Marx's own
; second deduction from the total product, made by the body that administers.
(transition fund-administration
  (when (and (is loom-house.title common)
             (is loom-house.directed-by board)))
  (do (set loom-house.surplus-to board)))

; RECALL. The Commune's principle and Lenin's: every official elective and
; revocable at any time. Unguarded on purpose — anyone may recall the board,
; from any situation, at no cost. It is the most favourable assumption in the
; file, and the third property is what it buys.
(transition recall-board
  (when (is loom-house.directed-by board))
  (do (set loom-house.directed-by weavers)))
