; 50TB of files -> classify (configurably, re-runnably) -> feed AI -> surface in CRM.
; The COMPONENT BANK, and the moves that realise one architecture out of it.

(load "../libraries/arch.lib.pol")

(instance bank (of arch)

  ; ---- the stages, in build order ------------------------------------------
  (cap hold enumerate extract classify catalog serve-ai surface done)

  (next (hold enumerate) (enumerate extract) (extract classify)
        (classify catalog) (catalog serve-ai) (serve-ai surface)
        (surface done) (done vacant))

  (chosen (hold vacant) (enumerate vacant) (extract vacant) (classify vacant)
          (catalog vacant) (serve-ai vacant) (surface vacant) (done vacant))

  ; what each stage demands — this is the BRIEF, formalised
  (needs-bulk  (hold yes) (enumerate yes) (extract no)  (classify no)
               (catalog no) (serve-ai no) (surface no)  (done no))
  (needs-scan  (hold no)  (enumerate no)  (extract yes) (classify no)
               (catalog no) (serve-ai no) (surface no)  (done no))
  (needs-rerun (hold no)  (enumerate no)  (extract no)  (classify yes)
               (catalog no) (serve-ai no) (surface no)  (done no))
  (needs-loose (hold no)  (enumerate no)  (extract no)  (classify no)
               (catalog no) (serve-ai no) (surface yes) (done no))

  ; ---- the component bank --------------------------------------------------
  (comp object-store nas
        bucket-list event-stream db-index
        pdf-lib ocr-service llm-vision
        rules-engine llm-classifier ml-model
        lakehouse rdbms doc-store
        vector-index dataset-export
        crm-api ipaas direct-db)

  (bulk (object-store yes) (nas no)
        (bucket-list no) (event-stream yes) (db-index yes)
        (pdf-lib vacant) (ocr-service vacant) (llm-vision vacant)
        (rules-engine vacant) (llm-classifier vacant) (ml-model vacant)
        (lakehouse vacant) (rdbms vacant) (doc-store vacant)
        (vector-index vacant) (dataset-export vacant)
        (crm-api vacant) (ipaas vacant) (direct-db vacant))

  (scans (object-store vacant) (nas vacant)
         (bucket-list vacant) (event-stream vacant) (db-index vacant)
         (pdf-lib no) (ocr-service yes) (llm-vision yes)
         (rules-engine vacant) (llm-classifier vacant) (ml-model vacant)
         (lakehouse vacant) (rdbms vacant) (doc-store vacant)
         (vector-index vacant) (dataset-export vacant)
         (crm-api vacant) (ipaas vacant) (direct-db vacant))

  ; llm-classifier is NOT deterministic across runs unless model+params are
  ; pinned — and the brief asks for re-runnable classification.
  (rerunnable (object-store vacant) (nas vacant)
              (bucket-list vacant) (event-stream vacant) (db-index vacant)
              (pdf-lib vacant) (ocr-service vacant) (llm-vision vacant)
              (rules-engine yes) (llm-classifier no) (ml-model yes)
              (lakehouse vacant) (rdbms vacant) (doc-store vacant)
              (vector-index vacant) (dataset-export vacant)
              (crm-api vacant) (ipaas vacant) (direct-db vacant))

  ; does the stage keep its output, or stream it away?
  (persists (object-store yes) (nas yes)
            (bucket-list no) (event-stream no) (db-index yes)
            (pdf-lib no) (ocr-service yes) (llm-vision no)
            (rules-engine yes) (llm-classifier yes) (ml-model yes)
            (lakehouse yes) (rdbms yes) (doc-store yes)
            (vector-index yes) (dataset-export yes)
            (crm-api no) (ipaas no) (direct-db no))

  (couples (object-store vacant) (nas vacant)
           (bucket-list vacant) (event-stream vacant) (db-index vacant)
           (pdf-lib vacant) (ocr-service vacant) (llm-vision vacant)
           (rules-engine vacant) (llm-classifier vacant) (ml-model vacant)
           (lakehouse vacant) (rdbms vacant) (doc-store vacant)
           (vector-index vacant) (dataset-export vacant)
           (crm-api contract) (ipaas loose) (direct-db tight))

  ; ---- provides: one junction entity per (component, stage) edge -----------
  (prov v1 v2 v3 v4 v5 v6 v7 v8 v9 v10
        v11 v12 v13 v14 v15 v16 v17 v18 v19)
  (p-comp (v1 object-store) (v2 nas)
          (v3 bucket-list) (v4 event-stream) (v5 db-index)
          (v6 pdf-lib) (v7 ocr-service) (v8 llm-vision)
          (v9 rules-engine) (v10 llm-classifier) (v11 ml-model)
          (v12 lakehouse) (v13 rdbms) (v14 doc-store)
          (v15 vector-index) (v16 dataset-export)
          (v17 crm-api) (v18 ipaas) (v19 direct-db))
  (p-cap  (v1 hold) (v2 hold)
          (v3 enumerate) (v4 enumerate) (v5 enumerate)
          (v6 extract) (v7 extract) (v8 extract)
          (v9 classify) (v10 classify) (v11 classify)
          (v12 catalog) (v13 catalog) (v14 catalog)
          (v15 serve-ai) (v16 serve-ai)
          (v17 surface) (v18 surface) (v19 surface))

  ; ---- requires: the same span, the other direction ------------------------
  (req q1 q2 q3 q4 q5 q6)
  (r-comp (q1 db-index) (q2 vector-index) (q3 dataset-export)
          (q4 crm-api) (q5 ipaas) (q6 direct-db))
  (r-cap  (q1 hold) (q2 extract) (q3 catalog)
          (q4 catalog) (q5 catalog) (q6 catalog))

  (cursor cur)
  (at (cur hold)))

(use arch)
(initial bank)

; ---- the moves: one per component ------------------------------------------
(pick hold-object-store object-store hold rr)
(pick hold-nas nas hold rr)
(pick enum-bucket-list bucket-list enumerate rr)
(pick enum-event-stream event-stream enumerate rr)
(pick enum-db-index db-index enumerate rr)
(pick ext-pdf-lib pdf-lib extract rr)
(pick ext-ocr ocr-service extract rr)
(pick ext-llm-vision llm-vision extract rr)
(pick cls-rules rules-engine classify rr)
(pick cls-llm llm-classifier classify rr)
(pick cls-ml ml-model classify rr)
(pick cat-lakehouse lakehouse catalog rr)
(pick cat-rdbms rdbms catalog rr)
(pick cat-doc-store doc-store catalog rr)
(pick ai-vector-index vector-index serve-ai rr)
(pick ai-dataset-export dataset-export serve-ai rr)
(pick crm-api-push crm-api surface rr)
(pick crm-ipaas ipaas surface rr)
(pick crm-direct-db direct-db surface rr)

; ---- what the brief does not say -------------------------------------------
(transition pdf-kind-unknown
  (when (is cur.at extract))
  (do (gap "the brief is silent: are the 50TB of PDFs digital-native or scanned? extract choice depends on it")))
