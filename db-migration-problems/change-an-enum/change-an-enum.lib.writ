; Shared by the models and the questions, because a questions file has its own
; form scope and there is no implicit prelude.
(load "stdlib.writ")

(form settled (is prod.old prod.new))
(form rolling (differ prod.old prod.new))

; Where we are going: the value exists, the fleet has settled on the release
; that knows it (old and new both r2, spelled without `settled`, which compares
; two paths and so cannot appear in a .rules guard), and a ticket is archived.
(form done (and (is status-check.allows-archived yes)
                (is prod.old r2) (is prod.new r2)
                (is t1.status archived)))
