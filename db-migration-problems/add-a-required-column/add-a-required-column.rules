; The same two questions, answered a second time by a different part of `writ`,
; so that `modality-cross-check.sh` can compare them. The two share no code; a
; disagreement is a bug in one of them, not a number to adjust.
;
; POLARITY:
;   `possible F` is the SATISFYING set — non-empty means it holds.
;   `live F` is the COUNTEREXAMPLE set — EMPTY means it holds.
(load "ct.rules")

(satisfies completes
  (and (is country-col.state present)
       (is country-col.filled yes)
       (is country-col.required yes)))

(can-reach can-still-finish completes)
(trapped no-dead-ends can-still-finish)
